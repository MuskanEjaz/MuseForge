# AI portfolio generation
# Recommended for this project after quota errors: Groq primary, Gemini/OpenAI optional fallback
AI_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional paid alternative
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional fallback
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Authentication signing secret (use a long random value)
AUTH_SECRET=replace_with_a_long_random_secret

# Google OAuth 2.0 Web Client ID
# Use the same client ID in the frontend .env as REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Verification, welcome and password-reset emails using Gmail
SMTP_SERVICE=gmail
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_google_app_password
MAIL_FROM="MuseForge <your_gmail_address@gmail.com>"

# Alternative generic SMTP configuration (use this instead of SMTP_SERVICE)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Server configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional custom persistent account-data directory
# MUSEFORGE_DATA_DIR=C:\Users\YOUR_NAME\.museforge

# Automated local tests only; do not use for real email delivery
# MAIL_TRANSPORT=json

# Persistent public portfolio links for deployment (recommended)
# Create a Supabase table using docs/PERSISTENT_PORTFOLIO_LINKS_SETUP.md
# and paste these values from Supabase Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_keep_private
SUPABASE_PORTFOLIOS_TABLE=public_portfolios
SUPABASE_REVIEWS_TABLE=public_reviews
