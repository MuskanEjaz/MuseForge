# =============================================================================
# MuseForge — environment
# Primary AI: IBM Granite on watsonx.ai.  Primary document processing: IBM Docling.
# =============================================================================

# ---- AI provider ------------------------------------------------------------
# watsonx = IBM Granite on watsonx.ai (this project's primary model)
# Other accepted values: groq | openai | gemini | auto
AI_PROVIDER=watsonx

# ---- IBM watsonx.ai / Granite ----------------------------------------------
# 1. Create an IBM Cloud account:            https://cloud.ibm.com/registration
# 2. Create a watsonx.ai project, copy its Project ID.
# 3. Create an IBM Cloud API key (Manage > Access (IAM) > API keys).
WATSONX_API_KEY=your_ibm_cloud_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
# Region endpoint for your watsonx project:
#   https://us-south.ml.cloud.ibm.com | https://eu-de.ml.cloud.ibm.com | https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite model. Confirm the exact id available in your region before the demo.
WATSONX_MODEL=ibm/granite-3-3-8b-instruct
WATSONX_API_VERSION=2024-05-31
# true  = Granite only, never silently fall back to a non-IBM model (honest for judging)
# false = fall back to a backup provider if watsonx is briefly unavailable
WATSONX_STRICT=false

# ---- IBM Docling (CV document processing) -----------------------------------
# Run docling-serve, e.g.:
#   docker run -p 5001:5001 quay.io/docling-project/docling-serve
# Leave DOCLING_URL empty to use the built-in PDF parsers instead.
DOCLING_URL=http://localhost:5001
DOCLING_API_KEY=
DOCLING_OCR=false
DOCLING_TIMEOUT_MS=20000

# ---- Backup providers (optional) --------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- App --------------------------------------------------------------------
# Output languages are fixed in code (15). Input may be in any language.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:3000
