# =============================================================================
# MuseForge — Environment Variable Template
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Long random value used for authentication/session security.
AUTH_SECRET=replace_with_a_long_random_secret

# Optional custom local data directory.
MUSEFORGE_DATA_DIR=./data

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# Primary provider: watsonx
# Other supported values: groq | openai | gemini | auto
AI_PROVIDER=watsonx

# Temporary cooldown after a provider failure, in milliseconds.
AI_PROVIDER_COOLDOWN_MS=60000

# -----------------------------------------------------------------------------
# IBM watsonx.ai / Granite
# -----------------------------------------------------------------------------
# IBM Cloud IAM API key.
WATSONX_API_KEY=your_ibm_cloud_api_key

# watsonx project ID. Use either PROJECT_ID or SPACE_ID as required.
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_SPACE_ID=

# Regional watsonx endpoint.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Use a Granite model confirmed as available in your region.
WATSONX_MODEL=ibm/granite-3-8b-instruct
WATSONX_API_VERSION=2024-05-31

# true: Granite only; do not silently use a non-IBM provider.
# false: allow a configured backup provider if watsonx is unavailable.
WATSONX_STRICT=true

# Used by some IBM verification utilities as an alternative variable name.
# Normally this can contain the same IAM key as WATSONX_API_KEY.
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key

# -----------------------------------------------------------------------------
# IBM Docling — CV document processing
# -----------------------------------------------------------------------------
# Local Docling server:
DOCLING_URL=http://localhost:5001

# Leave empty when the local server does not require authentication.
DOCLING_API_KEY=

# false works better for text-based PDFs.
# OCR may be enabled separately when testing scanned/image PDFs.
DOCLING_OCR=false
DOCLING_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# IBM Cloud Object Storage
# -----------------------------------------------------------------------------
# Public endpoint for the bucket region.
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud

# Use the exact bucket name copied from IBM Cloud.
COS_BUCKET=your_exact_cos_bucket_name

# IAM values from the dedicated museforge-app-cos service credential.
COS_API_KEY=your_cos_service_credential_apikey
COS_RESOURCE_INSTANCE_ID=your_cos_resource_instance_id

# Optional HMAC alternative. Leave empty when using IAM above.
COS_HMAC_ACCESS_KEY_ID=
COS_HMAC_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Optional backup AI providers
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# -----------------------------------------------------------------------------
# Supabase persistence
# -----------------------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PORTFOLIOS_TABLE=public_portfolios
SUPABASE_REVIEWS_TABLE=public_reviews

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Set according to the transport used by the backend.
MAIL_TRANSPORT=smtp
MAIL_FROM=MuseForge <no-reply@example.com>

# Optional Brevo API transport.
BREVO_API_KEY=

# SMTP configuration.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional named Nodemailer service. Leave empty when SMTP_HOST is used.
SMTP_SERVICE=

# -----------------------------------------------------------------------------
# LangChain
# -----------------------------------------------------------------------------
LANGCHAIN_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend variables
# -----------------------------------------------------------------------------
# CRA frontend variables must begin with REACT_APP_.
# Put these in the root/frontend .env when frontend and backend use separate files.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Backend verification of Google identity tokens.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Optional development/test controls
# -----------------------------------------------------------------------------
# These are used only by individual test/probe scripts, not normal app startup.
PROBE_TIMEOUT_MS=30000
SERVER_PATH=
RUNS=
SEED=
ONLY=
