# =============================================================================
# MuseForge — environment
# Primary AI: IBM Granite on watsonx.ai.  Primary document processing: IBM Docling.
# =============================================================================

# ---- AI provider ------------------------------------------------------------
# watsonx = IBM Granite on watsonx.ai (this project's primary model)
# Other accepted values: groq | openai | gemini | auto
AI_PROVIDER=watsonx

# ---- IBM watsonx.ai / Granite ----------------------------------------------
# 1. Create an IBM Cloud account:            https://cloud.ibm.com/registration
# 2. Create a watsonx.ai project, copy its Project ID.
# 3. Create an IBM Cloud API key (Manage > Access (IAM) > API keys).
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Region endpoint for your watsonx project:
#   https://us-south.ml.cloud.ibm.com | https://eu-de.ml.cloud.ibm.com | https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite model. Confirm the exact id available in your region before the demo.
WATSONX_MODEL=ibm/granite-3-8b-instruct
WATSONX_API_VERSION=2024-05-31
# true  = Granite only, never silently fall back to a non-IBM model (honest for judging)
# false = fall back to a backup provider if watsonx is briefly unavailable
WATSONX_STRICT=true

# ---- IBM Docling (CV document processing) -----------------------------------
# Run docling-serve, e.g.:
#   docker run -p 5001:5001 quay.io/docling-project/docling-serve
# Leave DOCLING_URL empty to use the built-in PDF parsers instead.
DOCLING_URL=http://localhost:5001
# Leave empty when the local server does not require authentication.
DOCLING_API_KEY=
DOCLING_OCR=false
DOCLING_TIMEOUT_MS=120000

# ---- Backup providers (optional) --------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- App --------------------------------------------------------------------
# Output languages are fixed in code (15). Input may be in any language.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000

# Authentication signing secret (use a long random value)
AUTH_SECRET=

# Verification, welcome and password-reset emails using Gmail

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=
BREVO_API_KEY=
MAIL_FROM="MuseForge <museforgeteam@gmail.com>"
MAIL_TRANSPORT=smtp

# Server configuration
PORT=5000
NODE_ENV=development

# Persistent public portfolio links for deployment (recommended)
# Create a Supabase table using docs/PERSISTENT_PORTFOLIO_LINKS_SETUP.md
# and paste these values from Supabase Project Settings > API.
SUPABASE_URL=https://bgvweywqbacwpwumcflp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PORTFOLIOS_TABLE=public_portfolios
SUPABASE_REVIEWS_TABLE=public_reviews

LANGCHAIN_ENABLED=true

COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET=
COS_API_KEY=
COS_RESOURCE_INSTANCE_ID=
# Optional HMAC alternative. Leave empty when using IAM above.
COS_HMAC_ACCESS_KEY_ID=
COS_HMAC_SECRET_ACCESS_KEY=

# Temporary cooldown after a provider failure, in milliseconds.
AI_PROVIDER_COOLDOWN_MS=60000
PROBE_TIMEOUT_MS=30000

# Optional custom local data directory.
MUSEFORGE_DATA_DIR=./data